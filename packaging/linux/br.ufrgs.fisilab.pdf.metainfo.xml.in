<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.pdf</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>PDF</name>
  <summary>Leitor e editor de PDF</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      O FisiLab PDF faz parte da Suíte FisiLab, alternativa livre para os alunos da UFRGS. Leia,
      comente, preencha e assine PDFs; organize, combine e divida páginas; edite, oculte trechos,
      proteja e exporte documentos.
    </p>
    <p>
      Baseado no PdfCraft, do ArtCraft Team e contribuidores (MIT ou Apache 2.0).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.pdf.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.pdf</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-pdf/issues</url>
  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>pdf</keyword>
    <keyword>viewer</keyword>
    <keyword>annotate</keyword>
    <keyword>forms</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>fisilab-pdf</binary>
    <mediatype>application/pdf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
